{
  "name": "wubi86-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "wrangler pages dev dist",
    "extract": "node scripts/extract-ms-lex.mjs",
    "data": "node scripts/build-data.mjs && npm run data:rev",
    "font:zhengkai": "sh -c 'P=.venv/bin/python; [ -x \"$P\" ] || P=python3; \"$P\" scripts/build-zhengkai-font.py'",
    "review:zheng": "sh -c 'P=.venv/bin/python; [ -x \"$P\" ] || P=python3; \"$P\" scripts/make-zhengkai-review.py \"$@\"' --",
    "review:zheng:y": "npm run review:zheng -- --key y",
    "review:zheng:apply": "sh -c 'P=.venv/bin/python; [ -x \"$P\" ] || P=python3; \"$P\" scripts/apply-zhengkai-review.py \"$@\"' --",
    "test:zheng": "sh -c 'P=.venv/bin/python; [ -x \"$P\" ] || P=python3; \"$P\" -m unittest discover -s scripts/tests -p \"test_zhengkai*.py\"'",
    "test:practice": "node --test scripts/tests/test-tutorial-tiers.mjs",
    "test:guide": "node --experimental-strip-types --test scripts/tests/test-beginner-guide.mjs",
    "roots:compare": "sh -c 'P=.venv/bin/python; [ -x \"$P\" ] || P=python3; \"$P\" scripts/make-roots-compare.py'",
    "roots:review": "sh -c 'P=.venv/bin/python; [ -x \"$P\" ] || P=python3; \"$P\" scripts/make-roots-review.py'",
    "chart:root": "sh -c 'P=.venv/bin/python; [ -x \"$P\" ] || P=python3; \"$P\" scripts/make-root-chart.py --pdf \"${PDF:-$HOME/Downloads/五笔字型入门指南.pdf}\"'",
    "data:rev": "sh -c 'P=.venv/bin/python; [ -x \"$P\" ] || P=python3; \"$P\" scripts/build-root-reverse.py'"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "opentype.js": "^2.0.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.149.0"
  },
  "license": "AGPL-3.0-only"
}
